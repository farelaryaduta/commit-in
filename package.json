{
  "name": "commitnow",
  "version": "0.1.0",
  "description": "AI-powered git commit message suggestions that match your repository's style",
  "type": "module",
  "bin": {
    "commitnow": "./dist/cli.mjs",
    "ci": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "serve": "node server/server.mjs",
    "dev:worker": "wrangler dev -c server/wrangler.jsonc --port 8787",
    "deploy": "wrangler deploy -c server/wrangler.jsonc"
  },
  "keywords": [
    "git",
    "commit",
    "cli",
    "ai",
    "commit-message"
  ],
  "author": "farelaryaduta",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.9.0"
  }
}